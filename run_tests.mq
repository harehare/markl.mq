include "marl_tests"
| run_tests([
    test_case("text_expressions_and_filters", test_text_expressions_and_filters),
    test_case("none_and_extra_environment", test_none_and_extra_environment),
    test_case("quoted_delimiter_and_comment", test_quoted_delimiter_and_comment),
    test_case("raw_block_preserves_template_syntax", test_raw_block_preserves_template_syntax),
    test_case("raw_block_reports_opening_tag_and_tracks_following_lines", test_raw_block_reports_opening_tag_and_tracks_following_lines),
    test_case("if_elif_else_and_nesting", test_if_elif_else_and_nesting),
    test_case("for_iteration_scope_and_current_value", test_for_iteration_scope_and_current_value),
    test_case("for_else_renders_only_for_empty_arrays", test_for_else_renders_only_for_empty_arrays),
    test_case("nested_for_else_and_binding_scope", test_nested_for_else_and_binding_scope),
    test_case("for_else_rejects_malformed_closing_tags", test_for_else_rejects_malformed_closing_tags),
    test_case("set_and_branch_scope", test_set_and_branch_scope),
    test_case("compiled_template_reuse", test_compiled_template_reuse),
    test_case("compiled_for_else_and_raw_reuse", test_compiled_for_else_and_raw_reuse),
    test_case("invalid_blocks_and_iterables", test_invalid_blocks_and_iterables),
    test_case("compile_errors_report_template_location", test_compile_errors_report_template_location),
    test_case("render_errors_keep_compiled_tag_location", test_render_errors_keep_compiled_tag_location)
  ])
