include "marl"
| include "test"

def test_text_expressions_and_filters():
  assert_eq(marl_render("# {{ title | upper }}\n{{ author[:name] }}", {title: "note", author: {name: "Ada"}}),
    "# NOTE\nAda")
end

def test_none_and_extra_environment():
  assert_eq(marl_render("{{ value }}-{{ extra }}", {value: None}, {env: {extra: 3}}), "-3")
end

def test_quoted_delimiter_and_comment():
  assert_eq(marl_render("A{{ \"}}\" }}{# {{ missing }} #}B", {}), "A}}B")
end

def test_raw_block_preserves_template_syntax():
  let template = "A{% raw %}\n{{ title }} {% if ok %}{# note #}\n{% endraw %}B{{ title }}"
  | assert_eq(marl_render(template, {title: "done"}),
      "A\n{{ title }} {% if ok %}{# note #}\nBdone")
end

def test_raw_block_reports_opening_tag_and_tracks_following_lines():
  let unclosed = try: marl_compile("é\r\n{% raw %}\r\n{{ ignored }}", {source_name: "page.md"})
                 catch(e): e[:message]
  | let after = try: marl_render("{% raw %}\r\n{{ ignored }}\r\n{% endraw %}\r\n{{ missing() }}",
                  {}, {source_name: "page.md"})
                catch(e): e[:message]
  | assert_eq(unclosed, "page.md:2:1: Unclosed raw block")
  | assert_eq(after, "page.md:4:1: Unknown function: missing")
end

def test_if_elif_else_and_nesting():
  let template = "{% if n == 1 %}one{% elif n == 2 %}{% if ok %}two{% else %}no{% endif %}{% else %}other{% endif %}"
  | assert_eq(marl_render(template, {n: 1}), "one")
  | assert_eq(marl_render(template, {n: 2, ok: true}), "two")
  | assert_eq(marl_render(template, {n: 2, ok: false}), "no")
  | assert_eq(marl_render(template, {n: 3}), "other")
end

def test_for_iteration_scope_and_current_value():
  let template = "{% for item in items %}{{ iteration[:index] }}:{{ . }};{% endfor %}{{ item }}"
  | assert_eq(marl_render(template, {items: ["a", "b"], item: "outer"}), "1:a;2:b;outer")
  | assert_eq(marl_render(template, {items: [], item: "outer"}), "outer")
end

def test_for_else_renders_only_for_empty_arrays():
  let template = "{% for item in items %}[{{ item }}]{% else %}empty {{ title }}{% endfor %}"
  | assert_eq(marl_render(template, {items: [], title: "Notes"}), "empty Notes")
  | assert_eq(marl_render(template, {items: [1, 2], title: "Notes"}), "[1][2]")
end

def test_nested_for_else_and_binding_scope():
  let nested = "{% for group in groups %}{% for item in group %}{{ item }}{% else %}-{% endfor %};{% endfor %}"
  | let scope = "{% set label = \"before\" %}{% for item in items %}{% set label = item %}{{ label }}{% else %}{% set label = \"empty\" %}{% endfor %}{{ label }}"
  | assert_eq(marl_render(nested, {groups: [[], [1, 2]]}), "-;12;")
  | assert_eq(marl_render(scope, {items: ["A"]}), "Abefore")
  | assert_eq(marl_render(scope, {items: []}), "empty")
end

def test_for_else_rejects_malformed_closing_tags():
  let extra = try: marl_compile("{% for item in items %}x{% else extra %}empty{% endfor %}", {source_name: "list.md"})
              catch(e): e[:message]
  | let wrong = try: marl_compile("{% for item in items %}x{% else %}empty{% endif %}", {source_name: "list.md"})
              catch(e): e[:message]
  | assert_eq(starts_with(extra, "list.md:1:25: Unexpected text after 'else'"), true)
  | assert_eq(starts_with(wrong, "list.md:1:40: Expected endfor"), true)
end

def test_set_and_branch_scope():
  let template = "{% set x = 1 %}{% if enabled %}{% set x = x + 2 %}{% endif %}{{ x }}"
  | assert_eq(marl_render(template, {enabled: true}), "3")
  | assert_eq(marl_render(template, {enabled: false}), "1")
end

def test_compiled_template_reuse():
  let ast = marl_compile("{{ title | upper }}")
  | assert_eq(marl_render_ast(ast, {title: "one"}), "ONE")
  | assert_eq(marl_render_ast(ast, {title: "two"}), "TWO")
end

def test_compiled_for_else_and_raw_reuse():
  let ast = marl_compile("{% for item in items %}{{ item }}{% else %}{% raw %}{{ item }}{% endraw %}{% endfor %}")
  | assert_eq(marl_render_ast(ast, {items: []}), "{{ item }}")
  | assert_eq(marl_render_ast(ast, {items: [1, 2]}), "12")
end

def test_invalid_blocks_and_iterables():
  let unclosed = try: marl_compile("{% if true %}x") == "unexpected" catch: true
  | let mismatch = try: marl_compile("{% for x in xs %}x{% endif %}") == "unexpected" catch: true
  | let extra = try: marl_compile("{% if true %}x{% endif ignored %}") == "unexpected" catch: true
  | let bad_iter = try: marl_render("{% for x in 3 %}x{% endfor %}", {}) == "unexpected" catch: true
  | assert_eq([unclosed, mismatch, extra, bad_iter], [true, true, true, true])
end

def test_compile_errors_report_template_location():
  let unknown = try: marl_compile("é\r\n x {% nope %}", {source_name: "unicode.md"})
                catch(e): e[:message]
  | let unclosed = try: marl_compile("x\n{% if true %}x", {source_name: "page.md"})
                   catch(e): e[:message]
  | let invalid_expr = try: marl_compile("a\n{{ 1 + }}", {source_name: "page.md"})
                       catch(e): e[:message]
  | assert_eq(unknown, "unicode.md:2:4: Unknown template tag 'nope'")
  | assert_eq(unclosed, "page.md:2:1: Unclosed template block")
  | assert_eq(starts_with(invalid_expr, "page.md:2:1: "), true)
end

def test_render_errors_keep_compiled_tag_location():
  let ast = marl_compile("one\n{% for item in items %}\n{{ missing() }}\n{% endfor %}", {source_name: "view.md"})
  | let failure = try: marl_render_ast(ast, {items: [1]})
                  catch(e): e[:message]
  | let bad_iter = try: marl_render("x\n{% for item in n %}x{% endfor %}", {n: 3}, {source_name: "page.md"})
                   catch(e): e[:message]
  | assert_eq(failure, "view.md:3:1: Unknown function: missing")
  | assert_eq(bad_iter, "page.md:2:1: For expects an array")
end

def test_whitespace_control_trims_around_tags():
  let template = "a\n{%- if ok -%}\n  X\n{%- endif -%}\n b {{- name -}} !{#- note -#} \n c"
  | assert_eq(marl_render(template, {ok: true, name: "N"}), "aXbN!c")
  | assert_eq(marl_render("{{ 5 - 3 }} {{ -1 + 3 }}", {}), "2 2")
end

def test_whitespace_control_keeps_line_tracking():
  let failure = try: marl_render("a\n  {{- x -}}  \n{{ missing() }}", {x: 1}, {source_name: "page.md"})
                catch(e): e[:message]
  | assert_eq(failure, "page.md:3:1: Unknown function: missing")
end

def test_helpers_default_link_frontmatter():
  assert_eq(marl_render("{{ n | default(\"none\") }}|{{ s | default(\"none\") }}", {n: None, s: "x"}), "none|x")
  | assert_eq(marl_render("{{ \"go\" | link(\"http://x\") }} {{ link(\"u\", \"b\") }}", {}), "[go](http://x) [b](u)")
  | assert_eq(marl_render("{{ meta | frontmatter() }}{{ title | h1 }}", {title: "T", meta: {title: "T", tags: ["a"], skip: None}}),
      "---\ntitle: T\ntags:\n  - a\n---\n# T")
end

def test_include_partials():
  let partials = {head: "# {{ title }}\n", item: "- {{ item }}\n"}
  | assert_eq(marl_render("{% include \"head\" %}{% for item in items %}{% include \"item\" %}{% endfor %}",
      {title: "T", items: ["a", "b"]}, {source_name: "page.md", partials: partials}), "# T\n- a\n- b\n")
  | let missing = try: marl_render("{% include \"nope\" %}", {}, {source_name: "page.md", partials: partials})
                  catch(e): e[:message]
  | assert_eq(missing, "page.md:1:1: Unknown partial 'nope'")
  | let recursive = try: marl_render("{% include \"a\" %}", {}, {source_name: "page.md", partials: {a: "{% include \"a\" %}"}})
               catch(e): e[:message]
  | assert_eq(recursive, "a:1:1: Include nesting is too deep at 'a'")
end

def test_helpers_indent_lists_table_escape_truncate():
  assert_eq(marl_render("{{ text | indent(2) }}", {text: "a\n\nb"}), "a\n\n  b")
  | assert_eq(marl_render("{{ bullets(items) }}", {items: ["x\ny", "z"]}), "- x\n  y\n- z")
  | assert_eq(marl_render("{{ items | numbered() }}", {items: ["a", "b"]}), "1. a\n2. b")
  | assert_eq(marl_render("{{ s | escape_md() }}", {s: "a*b_c|d"}), "a\\*b\\_c\\|d")
  | assert_eq(marl_render("{{ \"abcdef\" | truncate(3) }}|{{ \"ab\" | truncate(3) }}", {}), "abc…|ab")
  | assert_eq(marl_render("{{ rows | table([\"n\", \"a\"]) }}", {rows: [{n: "A", a: 1}, {n: "B", a: None}]}),
      "| n | a |\n| --- | --- |\n| A | 1 |\n| B |  |")
  | assert_eq(marl_render("{{ [[1, \"x|y\"]] | table([\"n\", \"a\"]) }}", {}),
      "| n | a |\n| --- | --- |\n| 1 | x\\|y |")
end

def test_undefined_variables_strict_and_lenient():
  let strict = try: marl_render("a\n{{ title }}", {}, {source_name: "page.md"})
               catch(e): e[:message]
  | assert_eq(strict, "page.md:2:1: Undefined variable 'title'")
  | assert_eq(marl_render("[{{ a }}|{{ b | default(\"d\") }}|{% if c %}y{% else %}n{% endif %}]", {}, {source_name: "page.md", lenient: true}), "[|d|n]")
  | let unknown = try: marl_render("{{ missing() }}", {}, {source_name: "page.md", lenient: true})
                  catch(e): e[:message]
  | assert_eq(unknown, "page.md:1:1: Unknown function: missing")
  | assert_eq(marl_render("{% include \"p\" %}", {}, {source_name: "page.md", partials: {p: "<{{ x }}>"}, lenient: true}), "<>")
end

def _fail(template, data = {}, options = {}):
  try: marl_render(template, data, options)
  catch(e): e[:message]
end

def test_include_scope_and_context():
  assert_eq(marl_render("{% set x = 1 %}{% include \"p\" %}{{ x }}", {}, {partials: {p: "{% set x = 2 %}{{ x }}"}}), "21")
  | assert_eq(marl_render("{% for i in [1, 2] %}{% include \"p\" %}{% endfor %}", {},
      {partials: {p: "<{{ . }}{{ i }}{{ iteration[:index] }}>"}}), "<111><222>")
  | assert_eq(marl_render("{% include n %}", {n: "p"}, {partials: {p: "ok"}}), "ok")
  | assert_eq(marl_render("a\n{%- include \"p\" -%}\n  b", {}, {partials: {p: "X"}}), "aXb")
  | assert_eq(marl_render("{% include \"a\" %}", {}, {partials: {a: "[{% include \"b\" %}]", b: "{% raw %}{{ x }}{% endraw %}"}}), "[{{ x }}]")
end

def test_include_errors():
  assert_eq(_fail("{% include \"p\" %}", {}, {partials: {p: "a\n{{ 1 + }}"}}), "p:2:1: Unexpected token: type=eof value=''")
  | assert_eq(_fail("{% include \"p\" %}", {}, {partials: {p: "a\n{{ missing() }}"}}), "p:2:1: Unknown function: missing")
  | assert_eq(_fail("x\n{% include \"p\" %}", {}, {source_name: "page.md"}), "page.md:2:1: Unknown partial 'p'")
  | assert_eq(_fail("{% include %}", {}, {source_name: "page.md"}), "page.md:1:1: Expected an expression")
end

def test_options_env_and_defaults():
  assert_eq(marl_render("{{ v }}", {v: 1}, {env: {v: 2}}), "2")
  | assert_eq(marl_render("{{ v }}", {v: 1}, {}), "1")
  | assert_eq(marl_render("{{ v }}", {v: 1}), "1")
  | assert_eq(_fail("{{ nope() }}", {}, {source_name: "a.md"}), "a.md:1:1: Unknown function: nope")
  | assert_eq(_fail("{{ nope() }}"), "<template>:1:1: Unknown function: nope")
  | assert_eq(marl_render_ast(marl_compile("{{ x }}", {source_name: "a.md"}), {x: 1}, {env: {x: 3}}), "3")
end

def test_lenient_undefined_variables():
  assert_eq(marl_render("{{ a[:b][:c] }}|{{ a[:b] | default(\"z\") }}", {a: {}}, {lenient: true}), "|z")
  | assert_eq(marl_render("{% for i in xs %}{{ i }}{% else %}none{% endfor %}", {}, {lenient: true}), "none")
  | assert_eq(marl_render("{% set y = x %}[{{ y }}]", {}, {lenient: true}), "[]")
  | assert_eq(marl_render("{{ let t = 1 | t }}", {}), "1")
  | assert_eq(_fail("{{ x }}|{{ f(y) }}", {}, {lenient: true}), "<template>:1:9: Unknown function: f")
  | assert_eq(_fail("{% for i in xs %}x{% endfor %}", {}, {source_name: "p.md"}), "p.md:1:1: Undefined variable 'xs'")
  | assert_eq(_fail("{% for i in n %}x{% endfor %}", {n: 3}, {lenient: true}), "<template>:1:1: For expects an array")
end

def test_helper_indent_and_lists_edge_cases():
  assert_eq(marl_render("{{ \"a\" | indent(0) }}|{{ \"a\\nb\" | indent(4) }}", {}), "a|a\n    b")
  | assert_eq(marl_render("{{ items | bullets() }}", {items: []}), "")
  | assert_eq(marl_render("{{ items | bullets() }}", {items: [1, None, "x"]}), "- 1\n- \n- x")
  | assert_eq(marl_render("{{ items | numbered() }}", {items: ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j\nk"]}),
      "1. a\n2. b\n3. c\n4. d\n5. e\n6. f\n7. g\n8. h\n9. i\n10. j\n    k")
  | assert_eq(marl_render("{{ items | numbered() }}", {items: ["a\nb"]}), "1. a\n   b")
end

def test_helper_table_edge_cases():
  assert_eq(marl_render("{{ [] | table([\"a\"]) }}", {}), "| a |\n| --- |")
  | assert_eq(marl_render("{{ [{a: 1}] | table([\"a\", \"b\"]) }}", {}), "| a | b |\n| --- | --- |\n| 1 |  |")
  | assert_eq(marl_render("{{ [[1]] | table([\"a\", \"b\"]) }}", {}), "| a | b |\n| --- | --- |\n| 1 |  |")
  | assert_eq(marl_render("{{ [[\"x\\ny\", None, 3]] | table([\"a\", \"b\", \"c\"]) }}", {}), "| a | b | c |\n| --- | --- | --- |\n| x y |  | 3 |")
end

def test_helper_escape_truncate_default_edge_cases():
  assert_eq(marl_render("{{ None | escape_md() }}|{{ 12 | escape_md() }}|{{ s | escape_md() }}", {s: "`[x](y)` <b> ~~ # \\"}),
      "|12|\\`\\[x\\](y)\\` \\<b\\> \\~\\~ \\# \\\\")
  | assert_eq(marl_render("{{ \"abc\" | truncate(3) }}|{{ \"abc\" | truncate(0) }}|{{ \"abcd\" | truncate(3) }}|{{ None | truncate(3) }}", {}),
      "abc|…|abc…|")
  | assert_eq(marl_render("{{ s | truncate(8) }}", {s: "héllo wörld 😀😀"}), "héllo wö…")
  | assert_eq(marl_render("{{ \"\" | default(\"d\") }}|{{ 0 | default(\"d\") }}|{{ false | default(\"d\") }}", {}), "d|0|false")
  | assert_eq(marl_render("{{ \"a|b\" | link(\"u\") }}", {}), "[a|b](u)")
end

def test_render_all_and_each():
  let pages = {"a.md": "{% include \"head.md\" %}A {{ site }}", "b.md": "B {{ site }}", "head.md": "# {{ site }}\n"}
  | let out = marl_render_all(pages, {site: "S"})
  | assert_eq(out["a.md"], "# S\nA S")
  | assert_eq(out["b.md"], "B S")
  | assert_eq(marl_render_all({"x.md": "{% include \"p\" %}"}, {}, {partials: {p: "P"}}), {"x.md": "P"})
  | let failed = try: marl_render_all({"bad.md": "{{ missing() }}"}, {}) catch(e): e[:message]
  | assert_eq(failed, "bad.md:1:1: Unknown function: missing")
  | assert_eq(marl_render_each("- {{ n }}", [{n: 1}, {n: 2}]), ["- 1", "- 2"])
  | assert_eq(marl_render_each("x", []), [])
end

def test_shared_helpers_and_nested_include_errors():
  assert_eq(keys(marl_compile("a")[:helpers]), [])
  | assert_eq(keys(marl_compile("{{ x | default(1) }}{% if y %}{{ link(\"u\", z) }}{% endif %}")[:helpers]), ["default", "link"])
  | assert_eq(keys(marl_compile("{% for i in xs %}{{ map(xs, truncate) }}{% endfor %}")[:helpers]), ["truncate"])
  | let bad = try: marl_render_all({"p.md": "{% include \"q.md\" %}", "q.md": "{{ missing() }}"}, {}) catch(e): e[:message]
  | assert_eq(bad, "q.md:1:1: Unknown function: missing")
end

def test_pipes_inside_call_arguments():
  assert_eq(marl_render("{{ join(tags | map(fn(t): upper(t) end), \", \") }}", {tags: ["a", "b"]}), "A, B")
  | assert_eq(marl_render("{{ join(tags | reverse, \"-\") }}/{{ len(tags | sort) }}", {tags: ["b", "a"]}), "a-b/2")
  | assert_eq(marl_render("{{ tags | join(\"+\") }}", {tags: ["x", "y"]}), "x+y")
end

def test_include_with_parameters():
  let partials = {c: "[{{ type }}{{ n }}{{ x }}]"}
  | assert_eq(marl_render("{% include \"c\" with {type: \"note\", n: 1 + 1} %}", {x: "!"}, {partials: partials}), "[note2!]")
  | assert_eq(marl_render("{% include \"c\" with {type: \"a\", n: 0, x: \"own\"} %}{{ x }}", {x: "outer"}, {partials: partials}), "[a0own]outer")
  | assert_eq(marl_render("{% include \"c\" with params %}", {params: {type: "p", n: 3, x: ""}}, {partials: partials}), "[p3]")
  | assert_eq(marl_render("{% include \"c\" with {type: \"with\", n: 1, x: \" with \"} %}", {}, {partials: partials}), "[with1 with ]")
  | assert_eq(_fail("{% include \"c\" with 3 %}", {}, {source_name: "page.md", partials: partials}), "page.md:1:1: With expects a dict")
end

def test_component_passes_body():
  let partials = {callout: "> [!{{ upper(type) }}] {{ body }}"}
  | assert_eq(marl_render("{% component \"callout\" with {type: \"tip\"} %}hi {{ x }}{% endcomponent %}|{{ type }}",
      {x: 1, type: "outer"}, {partials: partials}), "> [!TIP] hi 1|outer")
  | assert_eq(marl_render("{% component \"p\" %}{% for i in [1, 2] %}{{ i }}{% endfor %}{% endcomponent %}", {},
      {partials: {p: "<{{ body }}>"}}), "<12>")
  | assert_eq(_fail("{% component \"p\" %}x", {}, {source_name: "page.md"}), "page.md:1:1: Unclosed template block")
  | assert_eq(_fail("{% component \"p\" %}x{% endif %}", {}, {source_name: "page.md"}), "page.md:1:21: Expected endcomponent")
end

def test_capture_binds_rendered_text():
  assert_eq(marl_render("{% capture t %}a{{ 1 + 1 }}{% endcapture %}<{{ t }}>", {}), "<a2>")
  | assert_eq(marl_render("{% capture t %}{% for i in [1, 2] %}{{ i }}{% endfor %}{% endcapture %}{{ t | upper }}{{ len(t) }}", {}), "122")
  | assert_eq(starts_with(_fail("{% capture a b %}x{% endcapture %}", {}, {source_name: "page.md"}), "page.md:1:1: "), true)
  | assert_eq(starts_with(_fail("{% capture 1 %}x{% endcapture %}", {}, {source_name: "page.md"}), "page.md:1:1: Expected a variable name"), true)
end

def test_extends_overrides_blocks():
  let partials = {
    base: "[{% block head %}H{% endblock %}|{% block main %}default {{ who }}{% endblock %}]",
    mid: "{% extends \"base\" %}{% block head %}mid{% endblock %}",
    top: "{% extends \"mid\" %}{% block main %}top{% endblock %}"}
  | assert_eq(marl_render("{% extends \"base\" %}{% block main %}child {{ who }}{% endblock %}", {who: "W"}, {partials: partials}), "[H|child W]")
  | assert_eq(marl_render("{% extends \"base\" %}", {who: "W"}, {partials: partials}), "[H|default W]")
  | assert_eq(marl_render("{% extends \"top\" %}", {who: "W"}, {partials: partials}), "[mid|top]")
  | assert_eq(marl_render("{% extends \"mid\" %}{% block head %}child{% endblock %}", {who: "W"}, {partials: partials}), "[child|default W]")
  | assert_eq(marl_render("{% extends \"base\" %}text ignored{% set who = \"S\" %}", {}, {partials: partials}), "[H|default S]")
  | assert_eq(marl_render("{% block a %}x{% endblock %}{% if true %}{% block b %}y{% endblock %}{% endif %}", {}), "xy")
  | assert_eq(marl_render("{% extends \"p\" %}{% block b %}{{ . }}{% endblock %}", 7, {partials: {p: "{% for i in [1] %}{% block b %}{% endblock %}{% endfor %}"}}), "1")
end

def test_extends_errors():
  assert_eq(_fail("x\n{% extends \"nope\" %}", {}, {source_name: "page.md"}), "page.md:2:1: Unknown partial 'nope'")
  | assert_eq(_fail("{% extends \"a\" %}", {}, {partials: {a: "{% extends \"a\" %}"}}), "a:1:1: Include nesting is too deep at 'a'")
  | assert_eq(_fail("{% block %}x{% endblock %}", {}, {source_name: "page.md"}), "page.md:1:1: Expected a name")
  | assert_eq(_fail("{% block a %}x{% endif %}", {}, {source_name: "page.md"}), "page.md:1:15: Expected endblock")
  | assert_eq(_fail("{% endblock %}", {}, {source_name: "page.md"}), "page.md:1:1: Unexpected closing tag 'endblock'")
end

def test_themes_resolve_partials_in_order():
  let partials = {"default/c": "D", "zenn/c": "Z", "only.md": "O", "default/e.md": "E"}
  | assert_eq(marl_render("{% include \"c\" %}", {}, {partials: partials, theme: ["zenn", "default"]}), "Z")
  | assert_eq(marl_render("{% include \"c\" %}", {}, {partials: partials, theme: "default"}), "D")
  | assert_eq(marl_render("{% include \"c\" %}{% include \"only\" %}{% include \"e\" %}{{ theme }}", {},
      {partials: partials, theme: ["other", "default"]}), "DOEother")
  | assert_eq(marl_render("{% include \"only.md\" %}{% include \"zenn/c\" %}", {}, {partials: partials}), "OZ")
  | assert_eq(marl_render("{% include \"c\" %}", {}, {partials: {c: "plain", "t/c": "themed"}, theme: "t"}), "themed")
  | assert_eq(marl_render("{{ theme }}", {theme: "data"}, {theme: "opt"}), "data")
  | assert_eq(marl_render("{% if theme %}t{% else %}none{% endif %}", {}), "none")
  | assert_eq(marl_render("{% include \"c.tmpl\" %}", {}, {partials: {"c.tmpl": "T"}, ext: ".tmpl"}), "T")
  | assert_eq(marl_render("{% include \"c\" %}", {}, {partials: {"c.tmpl": "T"}, ext: ".tmpl"}), "T")
end

def test_parse_page_front_matter():
  let page = marl_parse_page("---\ntitle: \"A: B\"\nn: 3\nratio: -1.5\nok: true\nno: false\nnone: ~\nname: Plain # kept\ntags: [a, \"b, c\", 'd']\nempty: []\nlist:\n  - x\n  - 2\nauthor:\n  name: Ada\n  links:\n    - u\nsummary: >\n  one\n  two\nbody: |\n  keep\n    indent\n# comment\nlast: end\n---\n\n\n# Body\n")
  | assert_eq(page[:body], "# Body\n")
  | assert_eq(page[:meta][:title], "A: B")
  | assert_eq([page[:meta][:n], page[:meta][:ratio], page[:meta][:ok], page[:meta][:no], page[:meta][:none]], [3, -1.5, true, false, None])
  | assert_eq(page[:meta][:name], "Plain # kept")
  | assert_eq([page[:meta][:tags], page[:meta][:empty], page[:meta][:list]], [["a", "b, c", "d"], [], ["x", 2]])
  | assert_eq(page[:meta][:author], {name: "Ada", links: ["u"]})
  | assert_eq([page[:meta][:summary], page[:meta][:body], page[:meta][:last]], ["one two", "keep\n  indent", "end"])
end

def test_parse_page_without_front_matter():
  assert_eq(marl_parse_page("# Title\n---\nx"), {meta: {}, body: "# Title\n---\nx"})
  | assert_eq(marl_parse_page("---\ntitle: open"), {meta: {}, body: "---\ntitle: open"})
  | assert_eq(marl_parse_page("---\r\ntitle: T\r\n---\r\nbody"), {meta: {title: "T"}, body: "body"})
  | assert_eq(marl_parse_page("---\n---\nbody"), {meta: {}, body: "body"})
  | assert_eq(marl_parse_page(""), {meta: {}, body: ""})
end

def test_render_page_with_layout_and_theme():
  let partials = {layout: "<{{ page[:title] }}|{{ content }}|{{ site }}>", "alt/layout": "alt:{{ content }}", "wide/layout": "{% extends \"layout\" %}"}
  | let text = "---\ntitle: T\n---\nHi {{ page[:title] }}"
  | assert_eq(marl_render_page(text, {site: "S"}, {partials: partials}), "<T|Hi T|S>")
  | assert_eq(marl_render_page(text, {site: "S"}, {partials: partials, theme: "alt"}), "alt:Hi T")
  | assert_eq(marl_render_page("---\ntheme: alt\n---\nx", {}, {partials: partials}), "alt:x")
  | assert_eq(marl_render_page("---\ntheme: alt\n---\nx", {site: "S"}, {partials: partials, theme: "none"}), "<|x|S>")
  | assert_eq(marl_render_page("---\nlayout: false\n---\nx", {}, {partials: partials}), "x")
  | assert_eq(marl_render_page("---\nlayout: alt/layout\n---\nx", {}, {partials: partials}), "alt:x")
  | assert_eq(marl_render_page("x {{ page[:missing] | default(\"d\") }}", {}, {partials: partials, layout: "alt/layout"}), "alt:x d")
  | assert_eq(marl_render_page("plain", {}), "plain")
  | assert_eq(_fail("x", {}, {}), "x")
  | let missing = try: marl_render_page("---\nlayout: nope\n---\nx", {}, {source_name: "a.md", partials: partials})
                  catch(e): e[:message]
  | assert_eq(missing, "a.md: Unknown layout 'nope'")
end

def test_render_page_errors_use_source_name():
  let failure = try: marl_render_page("---\ntitle: T\n---\nline\n{{ missing() }}", {}, {source_name: "a.md"})
                catch(e): e[:message]
  | assert_eq(failure, "a.md:2:1: Unknown function: missing")
end

def test_render_pages_provides_page_index():
  let pages = {
    "old.md": "---\ntitle: Old\ndate: 2026-01-01\n---\nOld {{ page[:slug] }}",
    "new.md": "---\ntitle: New\ndate: 2026-03-01\n---\n{% for p in pages %}{{ p[:slug] }}:{{ p[:title] }};{% endfor %}",
    "sub/undated.md": "no front matter"}
  | let out = marl_render_pages(pages, {})
  | assert_eq(out["old.md"], "Old old")
  | assert_eq(out["new.md"], "new:New;old:Old;sub/undated:;")
  | assert_eq(out["sub/undated.md"], "no front matter")
  | let layout = marl_render_pages({"a.md": "---\ntitle: A\n---\nbody"}, {site: "S"}, {partials: {layout: "{{ site }}/{{ page[:name] }}/{{ len(pages) }}/{{ content }}"}})
  | assert_eq(layout, {"a.md": "S/a.md/1/body"})
  | let failed = try: marl_render_pages({"bad.md": "{{ missing() }}"}, {}) catch(e): e[:message]
  | assert_eq(failed, "bad.md:1:1: Unknown function: missing")
end

def test_article_helpers():
  assert_eq(marl_render("{{ \"  Hello, World! mq -- 入門 \" | slugify }}|{{ \"\" | slugify }}", {}), "hello-world-mq-入門|")
  | assert_eq(marl_render("{{ \"Hello, World! A_b-c\" | anchor }}", {}), "hello-world-a_b-c")
  | assert_eq(marl_render("{{ \"hello\" | capitalize }}|{{ \"\" | capitalize }}", {}), "Hello|")
  | assert_eq(marl_render("{{ \"2026-10-25\" | date(\"%b %d, %Y\") }}|{{ \"2026-10-25T13:00:00Z\" | date(\"%Y/%m/%d\") }}", {}), "Oct 25, 2026|2026/10/25")
  | assert_eq(marl_render("{{ \"a b\\n c  d\" | word_count }}|{{ \"\" | word_count }}", {}), "4|0")
  | assert_eq(marl_render("{{ \"word \" * 450 | reading_time }}|{{ \"short\" | reading_time }}|{{ \"あ\" * 1200 | reading_time }}", {}), "3|1|3")
  | assert_eq(marl_render("{{ \"body\" | details(\"More\") }}", {}), "<details>\n<summary>More</summary>\n\nbody\n\n</details>")
  | assert_eq(marl_render("{{ \"u.png\" | image(\"alt\") }}", {}), "![alt](u.png)")
end

def test_toc_helper():
  let text = "# T\n## Intro\n```\n## code\n```\n### Sub `x`\n#### deep\n## Next Step\n"
  | assert_eq(marl_render("{{ text | toc(2, 3) }}", {text: text}),
      "- [Intro](#intro)\n  - [Sub x](#sub-x)\n- [Next Step](#next-step)")
  | assert_eq(marl_render("{{ text | toc(1, 1) }}|{{ text | toc(5, 6) }}", {text: text}), "- [T](#t)|")
end

def test_helpers_reach_partials_and_blocks_that_use_them():
  assert_eq(marl_render("{% include \"p\" %}", {s: "A B"}, {partials: {p: "{{ s | slugify }}"}}), "a-b")
  | assert_eq(marl_render("{% component \"c\" %}{{ s | slugify }}{% endcomponent %}", {s: "A B"}, {partials: {c: "<{{ body }}>"}}), "<a-b>")
  | assert_eq(marl_render("{% extends \"base\" %}{% block main %}{{ s | slugify }}{% endblock %}", {s: "A B"},
      {partials: {base: "[{% block main %}{% endblock %}{{ \"x\" | capitalize }}]"}}), "[a-bX]")
  | assert_eq(marl_render("{% for i in [1] %}{% include \"p\" %}{% endfor %}", {s: "A B"}, {partials: {p: "{{ s | slugify }}"}}), "a-b")
  | assert_eq(marl_render("{{ default }}", {default: 5}), "5")
  | assert_eq(marl_render("{% include \"p\" %}", {default: 5}, {partials: {p: "{{ default }}"}}), "5")
end

def test_literal_code_skips_fences_and_spans():
  let lit = {literal_code: true}
  | assert_eq(marl_render("{{ x }} `{{ x }}` {{ x }}", {x: 1}, lit), "1 `{{ x }}` 1")
  | assert_eq(marl_render("``a `{{ x }}` b`` {{ x }}", {x: 1}, lit), "``a `{{ x }}` b`` 1")
  | assert_eq(marl_render("```sh\n${{ s }} {% if %}\n```\n{{ x }}", {x: 1}, lit), "```sh\n${{ s }} {% if %}\n```\n1")
  | assert_eq(marl_render("~~~\n{{ s }}\n~~~\n{{ x }}", {x: 1}, lit), "~~~\n{{ s }}\n~~~\n1")
  | assert_eq(marl_render("````\n```\n{{ s }}\n```\n````\n{{ x }}", {x: 1}, lit), "````\n```\n{{ s }}\n```\n````\n1")
  | assert_eq(marl_render("- item\n  ```\n  {{ s }}\n  ```\n{{ x }}", {x: 1}, lit), "- item\n  ```\n  {{ s }}\n  ```\n1")
  | assert_eq(marl_render("```\n{{ s }}", {}, lit), "```\n{{ s }}")
  | assert_eq(marl_render("```\n{{ s }}\n``\n{{ s }}\n```\nend", {}, lit), "```\n{{ s }}\n``\n{{ s }}\n```\nend")
end

def test_literal_code_edge_cases():
  let lit = {literal_code: true}
  | assert_eq(marl_render("a ` {{ x }}", {x: 1}, lit), "a ` 1")
  | assert_eq(marl_render("`a\n\n{{ x }}`", {x: 1}, lit), "`a\n\n1`")
  | assert_eq(marl_render("`a\n{{ x }}`", {x: 1}, lit), "`a\n{{ x }}`")
  | assert_eq(marl_render("``x` {{ x }}", {x: 1}, lit), "``x` 1")
  | assert_eq(marl_render("a ~ b {{ x }}", {x: 1}, lit), "a ~ b 1")
  | assert_eq(marl_render("```not `a fence` {{ x }}", {x: 1}, lit), "```not `a fence` 1")
  | assert_eq(marl_render("`{{ x }}`{{ x }}`{{ x }}`", {x: 1}, lit), "`{{ x }}`1`{{ x }}`")
  | assert_eq(marl_render("{%- if true -%} `{{ x }}` {%- endif -%}", {x: 1}, lit), "`{{ x }}`")
  | assert_eq(marl_render("{{ x }}`{{ x }}`", {x: 1}), "1`1`")
end

def test_literal_code_keeps_error_positions_and_reaches_partials():
  assert_eq(_fail("```\n{{ a }}\n```\n{{ missing() }}", {}, {literal_code: true, source_name: "page.md"}), "page.md:4:1: Unknown function: missing")
  | assert_eq(marl_render("{% include \"p\" %}", {}, {literal_code: true, partials: {p: "`{{ z }}` ok"}}), "`{{ z }}` ok")
  | assert_eq(marl_render("{% extends \"b\" %}{% block m %}`{{ z }}`{% endblock %}", {}, {literal_code: true, partials: {b: "[{% block m %}{% endblock %}`{{ q }}`]"}}), "[`{{ z }}``{{ q }}`]")
  | assert_eq(_fail("`{{ z }}`", {}, {source_name: "page.md"}), "page.md:1:2: Undefined variable 'z'")
end

def test_pages_treat_code_literally_by_default():
  let text = "---\ntitle: T\n---\n```yaml\ntoken: ${{ secrets.T }}\n```\n`{{ page[:title] }}` {{ page[:title] }}"
  | let partials = {layout: "<{{ content }}>"}
  | assert_eq(marl_render_page(text, {}, {partials: partials}), "<```yaml\ntoken: ${{ secrets.T }}\n```\n`{{ page[:title] }}` T>")
  | assert_eq(marl_render_page("`{{ page[:title] }}`", {}, {literal_code: false, partials: partials, lenient: true}), "<``>")
  | assert_eq(marl_render_pages({"a.md": "```\n{{ nope }}\n```"}, {}), {"a.md": "```\n{{ nope }}\n```"})
end

def test_try_render_pages_collects_errors():
  let pages = {"ok.md": "---\ntitle: A\n---\nfine {{ page[:title] }}", "bad.md": "x\n{{ missing() }}", "undefined.md": "{{ nope }}"}
  | let result = marl_try_render_pages(pages, {})
  | assert_eq(result[:outputs], {"ok.md": "fine A"})
  | assert_eq(result[:errors], {"bad.md": "bad.md:2:1: Unknown function: missing", "undefined.md": "undefined.md:1:1: Undefined variable 'nope'"})
  | assert_eq(marl_try_render_pages({"a.md": "x"}, {}), {outputs: {"a.md": "x"}, errors: {}})
  | assert_eq(marl_try_render_pages({}, {}), {outputs: {}, errors: {}})
  | assert_eq(_fail("{{ bad() }}", {}, {}), "<template>:1:1: Unknown function: bad")
  | let strict = try: marl_render_pages(pages, {}) catch(e): e[:message]
  | assert_eq(starts_with(strict, "bad.md:2:1: ") || starts_with(strict, "undefined.md:1:1: "), true)
end

def test_mermaid_option_renders_blocks():
  let page = "# T\n\n```mermaid\ngraph LR\n  A --> B\n```\n"
  | assert_eq(marl_render_page(page, {}), page)
  | assert_eq(contains(marl_render_page(page, {}, {mermaid: true}), "<svg"), true)
  | assert_eq(contains(marl_render_page(page, {}, {mermaid: true}), "```mermaid"), false)
  | assert_eq(contains(marl_render_page(page, {}, {mermaid: "text"}), "```text"), true)
  | assert_eq(marl_render_page("```mermaid\nnot a diagram\n```", {}, {mermaid: true}), "```mermaid\nnot a diagram\n```")
end

def test_html_option_wraps_page_in_theme_shell():
  let partials = {"alt/html.md": "<html><title>{{ page[:title] }}</title>{{ content }}</html>"}
  | let page = "---\ntitle: T\n---\n# Hi\n\n```mermaid\ngraph LR\n  A --> B\n```\n"
  | assert_eq(marl_render_page("# Hi", {}, {html: true}), "<h1>Hi</h1>")
  | assert_eq(marl_render_page("# Hi", {}, {html: true, partials: partials, theme: "alt"}), "<html><title></title><h1>Hi</h1></html>")
  | let out = marl_render_page(page, {}, {html: true, mermaid: true, partials: partials, theme: "alt"})
  | assert_eq(starts_with(out, "<html><title>T</title><h1>Hi</h1>\n<svg"), true)
  | assert_eq(contains(out, "<style>"), true)
  | assert_eq(contains(out, "&lt;style>"), false)
  | assert_eq(contains(marl_render_page(page, {}, {html: true, mermaid: true, mermaid_theme: "dark"}), "mm-dark"), true)
  | assert_eq(contains(marl_render_page("```mermaid\nnope\n```", {}, {html: true, mermaid: true}), "language-mermaid"), true)
end

def test_html_env_flag_reaches_templates():
  let partials = {"c.md": "{% if html %}H{% else %}M{% endif %}"}
  | assert_eq(marl_render_page("{% include \"c\" %}", {}, {partials: partials}), "M")
  | assert_eq(marl_render_page("{% include \"c\" %}", {}, {partials: partials, html: true}), "<p>H</p>")
  | assert_eq(marl_render_page("{% include \"c\" %}", {}, {partials: partials, html: true, env: {html: false}}), "<p>M</p>")
end
